index=windows_security sourcetype="WinEventLog:Security" (EventCode=4624 OR EventCode=4625)
| rex field=Message "(?s)Account For Which Logon Failed:.*?Account Name:\s+(?<failed_user>[^\r\n]+)"
| rex field=Message "(?s)New Logon:.*?Account Name:\s+(?<successful_user>[^\r\n]+)"
| eval target_user=if(EventCode=4625,failed_user,successful_user)
| eval failed=if(EventCode=4625,1,0)
| eval successful=if(EventCode=4624,1,0)
| where isnotnull(target_user) AND target_user!="-"
| bin _time span=10m
| stats sum(failed) as failed_attempts sum(successful) as successful_logons by _time host target_user
| where failed_attempts>=5 AND successful_logons>=1
