index=windows_security sourcetype="WinEventLog:Security" EventCode=4625
| rex field=Message "(?s)Account For Which Logon Failed:.*?Account Name:\s+(?<target_user>[^\r\n]+)"
| rex field=Message "Source Network Address:\s+(?<source_ip>[^\r\n]+)"
| eval target_user=trim(target_user)
| where target_user!="-"
| bin _time span=10m
| stats count as failed_attempts by _time host target_user source_ip
| where failed_attempts >= 5
